# Copie este arquivo para .env.local e preencha com os valores reais.
# Nunca commite .env.local (já está no .gitignore).

# Supabase — em supabase.com > seu projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente para uso em scripts/servidor confiável (nunca no frontend).
SUPABASE_SERVICE_ROLE_KEY=

# Bling API v3 — developer.bling.com.br, criar um "aplicativo" para obter estas chaves.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=http://localhost:3000/api/bling/callback
